{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "base_url", "viewports", "pages", "journeys"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type":"string", "pattern":"^[a-z][a-z0-9-]{0,39}$"},
    "base_url": {"type":"string", "maxLength":2048},
    "viewports": {"type":"array", "minItems":1, "maxItems":3, "items":{"type":"object", "additionalProperties":false, "required":["id","width","height"], "properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"}, "width":{"type":"integer","minimum":320,"maximum":1920},"height":{"type":"integer","minimum":600,"maximum":1440}}}},
    "pages": {"type":"array", "minItems":1,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["id","path","checks","viewports","priority","why"],"properties":{
      "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"path":{"type":"string"},
      "title_contains":{"type":"string","minLength":1},"h1_contains":{"type":"string","minLength":1},
      "language":{"type":"string","minLength":2},
      "checks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["content","structure","axe","semantics","image-alt","reflow"]}},
      "viewports":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
      "priority":{"enum":["P0","P1","P2"]},"why":{"type":"string","minLength":1}
    }}},
    "journeys":{"type":"array","maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["id","start","viewport","priority","why","steps"],"properties":{
      "id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"start":{"type":"string"},"viewport":{"type":"string"},"priority":{"enum":["P0","P1","P2"]},"why":{"type":"string","minLength":1},
      "accessibility":{"type":"boolean"},"steps":{"type":"array","minItems":1,"maxItems":30,"items":{"$ref":"#/$defs/step"}}
    }}}
  },
  "$defs":{
    "locator":{"type":"object","additionalProperties":false,"minProperties":1,"properties":{
      "role":{"type":"string","minLength":1},"name":{"type":"string"},"label":{"type":"string"},"selector":{"type":"string","minLength":1},"scope":{"type":"string"},"exact":{"type":"boolean"},"level":{"type":"integer","minimum":1,"maximum":6}
    },"oneOf":[{"required":["role"],"not":{"anyOf":[{"required":["label"]},{"required":["selector"]}]}},{"required":["label"],"not":{"anyOf":[{"required":["role"]},{"required":["selector"]}]}},{"required":["selector"],"not":{"anyOf":[{"required":["role"]},{"required":["label"]}]}}]},
    "step":{"type":"object","additionalProperties":false,"required":["action"],"properties":{
      "action":{"enum":["click","press","fill","expect","expect-url","keyboard","tab-to","axe","links"]},
      "locator":{"$ref":"#/$defs/locator"},"value":{"type":"string","maxLength":1000},
      "assert":{"enum":["visible","hidden","focused","text","value","attribute","count"]},
      "attribute":{"type":"string"},"count":{"type":"integer","minimum":0,"maximum":100},
      "hosts":{"type":"array","minItems":1,"items":{"type":"string"}},"path_prefix":{"type":"string"},"min_count":{"type":"integer","minimum":0,"maximum":100},"max_tabs":{"type":"integer","minimum":1,"maximum":30}
    }}
  }
}
